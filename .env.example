# AURA AI Configuration (.env.example)
#
# IMPORTANT SECURITY DIRECTIVE:
# NEVER commit real credentials to Git or expose keys to the frontend bundle.
# Environment variables listed here are strictly read on the server side (Node.js).
# The client browser NEVER receives these keys.

# AI Provider Selection: 'openai' | 'anthropic' | 'gemini' | 'ollama' | 'local'
AURA_AI_PROVIDER=openai

# Secret API Key (server-side only)
AURA_AI_API_KEY=your_secret_api_key_here

# Specific Model Override (optional)
# Examples: 'gpt-4o-mini', 'claude-3-5-sonnet-20241022', 'gemini-1.5-flash', 'llama3'
AURA_AI_MODEL=gpt-4o-mini

# Custom Base URL (optional, for local LLMs, Ollama, vLLM, or custom proxies)
# AURA_AI_BASE_URL=http://localhost:11434/v1

# Generation Parameters
AURA_AI_TEMPERATURE=0.3
AURA_AI_MAX_TOKENS=500
